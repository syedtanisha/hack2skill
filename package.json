{
  "name": "edubridge-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm run build --workspace=@edubridge/backend && npm run build --workspace=@edubridge/frontend",
    "build:frontend": "npm run build --workspace=@edubridge/frontend",
    "build:backend": "npm run build --workspace=@edubridge/backend",
    "preview": "npm --prefix frontend run preview"
  },
  "dependencies": {
    "@google/genai": "^2.29.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "typescript": "^5.7.3"
  }
}
